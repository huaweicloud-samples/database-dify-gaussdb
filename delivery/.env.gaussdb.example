# =============================================================================
# Dify 1.16.1 + GaussDB 部署配置模板
# 使用方法：cp .env.gaussdb.example .env，修改下面的配置项后 docker compose up -d
# =============================================================================

# --- 核心密钥（必填，生产环境务必修改）---
# 用于签名 session/JWT/文件URL，至少 32 字符。可用 `openssl rand -hex 32` 生成
SECRET_KEY=请替换为随机32字符以上的密钥
# 初始化管理员密码（首次 setup 时验证，留空则首次访问时设置）
INIT_PASSWORD=请设置初始化密码

# --- 访问地址（按实际部署主机 IP/域名修改）---
# 走 nginx 统一入口（端口80），URL 不带端口号；若不开 nginx 直连 api:5001/web:3000 则带端口
CONSOLE_API_URL=http://<部署主机IP>
CONSOLE_WEB_URL=http://<部署主机IP>
SERVICE_API_URL=http://<部署主机IP>
APP_API_URL=http://<部署主机IP>
APP_WEB_URL=http://<部署主机IP>
FILES_URL=http://<部署主机IP>
FILES_AVATAR_URL=http://<部署主机IP>

# --- 关系数据库（GaussDB，客户已有实例）---
# DB_TYPE=gaussdb 时底层用 opengauss+psycopg2 方言连接（O模式/DBCOMPATIBILITY='A'）
DB_TYPE=gaussdb
DB_HOST=<GaussDB实例IP>
DB_PORT=<GaussDB实例端口，如19995>
DB_USERNAME=<GaussDB用户名>
DB_PASSWORD=<GaussDB密码>
DB_DATABASE=<数据库名，如dify>
# 连接池（按 GaussDB 实例规格调整）
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600

# --- 向量数据库（GaussDB，通常与关系库同实例）---
VECTOR_STORE=gaussdb
GAUSSDB_HOST=<GaussDB实例IP，通常与DB_HOST相同>
GAUSSDB_PORT=<GaussDB实例端口，如19995>
GAUSSDB_USER=<GaussDB用户名>
GAUSSDB_PASSWORD=<GaussDB密码>
GAUSSDB_DATABASE=<数据库名，如dify>
GAUSSDB_MIN_CONNECTION=1
GAUSSDB_MAX_CONNECTION=5
# 索引类型：ivfflat（≤1024维，小数据量）或 diskann（>1024维必须，大数据量）
# 集中式：ivfflat≤1024 / diskann≤4096(>1024自动启用PQ降维)
# 分布式：统一≤1024维（建表硬限）
GAUSSDB_INDEX_TYPE=ivfflat

# --- Redis（使用 compose 自带 redis 容器，默认即可）---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
CELERY_BROKER_URL=redis://:difyai123456@redis:6379/1
CELERY_BACKEND=redis

# --- 迁移（首次部署设 true 自动建表，之后可改 false）---
MIGRATION_ENABLED=true

# --- compose profiles（不要改，gaussdb 不启动内置DB/向量库容器）---
COMPOSE_PROFILES=gaussdb,gaussdb,collaboration
