# Dify GaussDB 适配 — 部署配置模板
# 交付时复制为 .env 并填入客户实际 GaussDB 信息

# ============ 关系库配置 ============
DB_TYPE=gaussdb
DB_HOST=<gaussdb-host>
DB_PORT=<gaussdb-port>
DB_USERNAME=<dify-user>
DB_PASSWORD=<dify-password>
DB_DATABASE=dify

# ============ 向量库配置（同一 GaussDB 实例） ============
VECTOR_STORE=gaussdb
GAUSSDB_HOST=<gaussdb-host>
GAUSSDB_PORT=<gaussdb-port>
GAUSSDB_USER=<dify-user>
GAUSSDB_PASSWORD=<dify-password>
GAUSSDB_DATABASE=dify
GAUSSDB_MIN_CONNECTION=1
GAUSSDB_MAX_CONNECTION=5
# 索引类型：≤1024 维用 ivfflat（默认）；>1024 维用 diskann
GAUSSDB_INDEX_TYPE=ivffflat

# ============ 其他 dify 必填配置（按 dify 标准部署） ============
SECRET_KEY=<生成强随机密钥，如 openssl rand -base64 42>
CONSOLE_API_URL=http://<dify-host>:5001
CONSOLE_WEB_URL=http://<dify-host>:3000
SERVICE_API_URL=http://<dify-host>:5001
APP_WEB_URL=http://<dify-host>:3000

# Redis（dify 完整服务需要）
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>

# Celery
CELERY_BROKER_URL=redis://:<redis-password>@<redis-host>:6379/1
CELERY_BACKEND=redis
